{
  "name": "@eve-online-tools/eve-sde",
  "version": "0.1.0",
  "description": "Typed access to the EVE Online Static Data Export over HTTP, with Vite and Rollup plugins",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eve-online-tools/node-packages.git",
    "directory": "packages/eve-sde"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./rollup": {
      "types": "./dist/rollup/index.d.ts",
      "default": "./dist/rollup/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react-query": {
      "types": "./dist/react-query/index.d.ts",
      "default": "./dist/react-query/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --workspace-root vitest run packages/eve-sde",
    "test:live": "vitest run --config vitest.live.config.ts",
    "generate:types": "tsx scripts/generate-types.ts",
    "format:check": "pnpm --workspace-root exec oxfmt --check \"packages/eve-sde/src/**/*.ts\"",
    "oxlint": "pnpm --workspace-root exec oxlint packages/eve-sde"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.107.1",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "rollup": "catalog:",
    "tsup": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "eve-sde": "./dist/cli.js"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "rollup": "^4.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
